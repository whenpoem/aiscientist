{
  "mcpServers": {
    "memory": {
      "command": "uv",
      "args": ["run", "python", "-m", "memory_mcp.dev_server"],
      "env": { "RESEARCH_AGENT_DEV": "1" }
    },
    "verify": {
      "command": "uv",
      "args": ["run", "python", "-m", "verify_mcp.dev_server"],
      "env": { "RESEARCH_AGENT_DEV": "1" }
    },
    "prove": {
      "_comment": "Default embedding backend is 'local' (sentence-transformers). Run 'uv sync --extra proof' first. Override with RESEARCH_AGENT_EMBED_BACKEND=mock|openai if needed; tests pin 'mock' via conftest.py.",
      "command": "uv",
      "args": ["run", "python", "-m", "prove_mcp.dev_server"],
      "env": { "RESEARCH_AGENT_DEV": "1" }
    },
    "lean": {
      "_comment": "Lean reinsurance MCP (P4). Auto-dispatched via scripts/lean_mcp_or_noop.py: if elan + lake + lean are on PATH the wrapper forwards to lean-lsp-mcp; otherwise it exits 0 with a stderr note and the prover agent reports the tool as absent. Follow docs/setup-lean.md to install the toolchain.",
      "command": "uv",
      "args": ["run", "python", "scripts/lean_mcp_or_noop.py"],
      "env": {
        "LEAN_PROJECT_PATH": "${CLAUDE_PROJECT_DIR}/.research-agent/lean/claudescientist-proofs"
      }
    },
    "cockpit": {
      "command": "uv",
      "args": ["run", "python", "-m", "cockpit.mcp_server"],
      "env": { "RESEARCH_AGENT_DEV": "1" }
    },
    "arxiv": {
      "command": "uv",
      "args": ["tool", "run", "arxiv-mcp-server"]
    },
    "openalex": {
      "command": "npx",
      "args": ["-y", "openalex-research-mcp"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/leakage_guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/destructive_bash_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/provenance_log.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/intervention_pump.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/intervention_pump.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_flush.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
